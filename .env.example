# Copy to .env and change only what differs. .env is not committed.
# Windows (Docker Desktop): leave 1000. Synology NAS: your DSM uid/gid from `id` (usually 1026 / 100).
PUID=1000
PGID=1000
# Password for the Paseo web UI / app connection. Required.
PASEO_PASSWORD=change-me
# Only if you open Paseo by a DNS name instead of an IP, e.g. my-pc.tail1234.ts.net
PASEO_HOSTNAMES=
MEETING_ROOM=on
MEETING_ROOM_TOKEN=
